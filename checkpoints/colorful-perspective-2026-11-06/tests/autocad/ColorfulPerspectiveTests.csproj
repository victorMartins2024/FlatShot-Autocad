<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ColorFlatshot</RootNamespace>
    <AssemblyName>ColorfulPerspectiveTests</AssemblyName>
    <Version>1.4.0</Version>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2025</AutoCADDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\ColorfulFlatShot\</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCADDir)\AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCADDir)\AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgdBrep"><HintPath>$(AutoCADDir)\AcDbMgdBrep.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AutoCADDir)\AcMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcWindows"><HintPath>$(AutoCADDir)\AcWindows.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="PerspectiveHostTests.cs" />
    <Compile Include="..\..\src\Models\*.cs" />
    <Compile Include="..\..\src\Services\*.cs" />
    
    
  </ItemGroup>
</Project>


